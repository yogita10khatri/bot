POLYMARKET_PRIVATE_KEY=your_private_key_here
CAPITAL_USD=50
DRY_RUN=true # true for testing, false for real trading

# STRATEGIES CONFIG false as defualt
ARBITRAGE_ENABLED=false 
DIPARB_ENABLED=false
SMARTMONEY_ENABLED=false
TREND_ANALYSIS_ENABLED=false

# ============================================================================
# NETWORK / VPN
# ============================================================================
# Polymarket geo-restricts several countries, India among them. Read
# docs/VPN_SETUP.md before enabling live trading — routing around a geoblock
# breaches Polymarket's Terms of Service and can get an account locked.
#
# Two ways to tunnel. Pick ONE.
#
# (a) Full-tunnel VPN on the host (WireGuard, OpenVPN, a desktop VPN app, or
#     the gluetun container in docker-compose.vpn.yml). Leave PROXY_URL empty —
#     the OS routes everything and the bot needs no configuration.
#
# (b) Per-process proxy. Only the bot is tunnelled, and if the proxy dies the
#     bot errors out instead of silently leaking to your real IP. Preferred on
#     a laptop you also use for other things.
#
# PROXY_URL=socks5://user:pass@proxy-host:1080
# PROXY_URL=http://user:pass@proxy-host:8080

# Refuse to start when PROXY_URL is unset. Set this to true if you rely on
# option (b) — it turns "I forgot to configure the proxy" into a startup error
# rather than an order placed from your real IP.
# REQUIRE_PROXY=true

# Hosts that skip the proxy (comma separated). Loopback is always bypassed.
# NO_PROXY=localhost,127.0.0.1

# Countries the geo preflight refuses to trade from (ISO 3166-1 alpha-2).
# Defaults to DEFAULT_BLOCKED_COUNTRIES in src/core/geo.ts. Set to an empty
# value to disable the country check entirely.
# BLOCKED_COUNTRIES=US,IN,FR,BE,PL,TH,SG,GB,AU,CA

# Skip the geo preflight. Use for CI and offline dry runs only.
# SKIP_GEO_CHECK=false
